#INFO TITLE="Ch@0s GUI", USER="Root/Admin", MAIN="the_cha0s_begins", RANDOM=true, DEFINES_REQ="T_USER" & "COMMUNICATION_CHANNEL", MAIN="ChaosGUI"
#include <framework.h>

extern __PROCESS_INFO_ Program; // Program info (process ID, ..., DynamicProperties[])

char** Tokens;                  // Tokenized input to console (only if GUI mode is false)
extern char** ERROR;          // List of error messages
#define EXE_AS_CHILD_ERROR 0

int __attribute__((FATAL_ERROR)) FE() {
	// Gets run on errors
}

root int ChaosGUI(int argc, char** argv) {
	// Layer 1 - You should be fine...
	printf("ChaosGUI by Hacklord Captain Bear\nCopyright ChaosGUI (November 2025)\nIf this came without a LICENSE file or you deleted it type \"/uninstall this\".\nUse without LICENSE is not allowed.\nLayer 1 - You should be fine...\n");
	for(int i = 0;i < argc;i++) {
		char** arg = argv;
		if(strcmp(arg[i], "-gui_mode") == 0) {
			// Read value
			i++;
			if(!(i < argc)) {
				printf("[ERROR] No value for GUI mode.\n");
				return -1; // Setup error
			}
			if(strcmp(arg[i], "true") == 0) {
				// Value true
				Program.DynamicProperties[GUI_MODE_PROPERTY] = true;
				printf("[INFO][Properties] GUI mode set.\n");
			} else if(strcmp(arg[i], "false") == 0) {
				// Value false
				Program.DynamicProperties[GUI_MODE_PROPERTY] = false;
			} else {
				printf("[ERROR] \"%s\" is not a valid value for \"-gui_mode\".\n", arg[i]);
				return -1; // Setup error
			}
		}
	}
	// Layer 2 - YAAI!
	printf("Layer 2 - YAAI!\nYou are an Idiot!\n");
	// Layer 3 - RuN IdiOT!
	printf("Layer 3 - RuN IdiOT!\n");
	// Chase   - Th3 €h@0$ b3g!n$
	printf("Chase   - Th3 €h@0$ b3g!n$\n");
	if(__SYS_EXECUTE__As_child(Tokens[0])) {
		printf("[ERROR] \"%s\" is not a command, console script or executable.\nPossible problems are:\n\t- Path to \"%s\" not included.\n\t- \"%s\" has the wrong type or is no longer supported.\n\t- No space for more processes.\nMost likely: %s", Tokens[0], Tokens[0], Tokens[0], ERROR[EXE_AS_CHILD_ERROR]);
	}
}